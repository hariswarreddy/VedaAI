# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# MongoDB (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/vedaai

# Redis (Upstash supports rediss://, but BullMQ needs maxRetriesPerRequest=null; we handle that)
